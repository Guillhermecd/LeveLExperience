SERVER_PORT=1337
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5440/kanban
SPRING_DATASOURCE_USERNAME=kanban
SPRING_DATASOURCE_PASSWORD=kanban

# HS256 needs >= 32 bytes or the app fails to boot (WeakKeyException).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes-please
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

EMAIL_ENABLED=true
EMAIL_FROM=no-reply@oaksd.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
